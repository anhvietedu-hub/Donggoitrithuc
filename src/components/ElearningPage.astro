---
import '../styles/elearning.css';
import Tracker from './Tracker.astro';
import {
  course,
  registerForm,
  contact,
  pains,
  comparison,
  curriculum,
  trainer,
  gallery,
  testimonialVideos,
  gifts,
  audienceFit,
  audienceMisfit,
  vnd,
  checkoutReady,
} from '../data/elearning';

// Cùng một trang chạy ở hai địa chỉ: gốc của donggoitrithuc.mavatraining.com
// và /elearning/ trên donggoi.mavatraining.com. Logo phải trỏ về đúng trang chủ của từng nơi.
interface Props {
  homeHref: string;
}
const { homeHref } = Astro.props;

const title = 'Khoá học E-Learning Kỹ năng Đóng gói Tri thức | MAVA';
const description =
  'Biến kinh nghiệm thực chiến thành trọn bộ 5 tài liệu đào tạo chuẩn hoá: Outline, Slide, Bộ đề, Lesson Plan, Workbook. Học online, truy cập trọn đời, mỗi ngày 30 phút.';

// Icon cho bìa từng phần. Vẽ thẳng bằng SVG nên không phải tải thêm ảnh nào.
const partIcons: Record<string, string> = {
  bulb: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10.5 21h3"/><path d="M12 2.5a6.5 6.5 0 0 0-3.8 11.8c.5.3.8.9.8 1.5v.2h6v-.2c0-.6.3-1.2.8-1.5A6.5 6.5 0 0 0 12 2.5z"/></svg>',
  doc: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2.5h8l4.5 4.5V21.5H6z"/><path d="M14 2.5V7h4.5"/><path d="M9 12h6M9 15.5h6M9 19h3"/></svg>',
  slide: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="3.5" width="19" height="13" rx="1.8"/><path d="M12 16.5v4M8.5 20.5h7"/><path d="M6.5 8h7M6.5 11.5h4.5"/></svg>',
  quiz: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 4.5H6.5a1.5 1.5 0 0 0-1.5 1.5v14a1.5 1.5 0 0 0 1.5 1.5h11a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5h-2"/><rect x="8.5" y="2.5" width="7" height="4" rx="1.2"/><path d="M8.5 12l1.8 1.8 3.4-3.6M8.5 17.5h7"/></svg>',
  plan: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="17" rx="2"/><path d="M2.5 9.5h19M8 2.5v4M16 2.5v4"/><path d="M12 13v3l2 1.2"/></svg>',
};

// Hình vẽ nét mảnh đứng trước mỗi ý ở mục "Bạn có đang ở trong tình trạng này không?".
const painSvg = (paths: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const painIcons: Record<string, string> = {
  blank: painSvg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M10.2 11.4a1.9 1.9 0 1 1 2.7 1.7c-.6.3-.9.7-.9 1.2v.4"/><path d="M12 17.4h.01"/>'),
  talk: painSvg('<path d="M20.5 12a8.5 8.5 0 0 1-12.4 7.5L3.5 20.5l1.1-4.3A8.5 8.5 0 1 1 20.5 12z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/>'),
  relay: painSvg('<path d="M9.5 16.5H7a4.5 4.5 0 0 1 0-9h2.5"/><path d="M14.5 7.5H17a4.5 4.5 0 0 1 2.9 7.9"/><path d="M8 12h3"/><path d="M3.5 3.5l17 17"/>'),
  time: painSvg('<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>'),
  ai: painSvg('<path d="M11 3.5l1.7 4.8 4.8 1.7-4.8 1.7L11 16.5l-1.7-4.8L4.5 10l4.8-1.7z"/><path d="M15.5 16.5l4 4M19.5 16.5l-4 4"/>'),
  loop: painSvg('<path d="M20.5 12a8.5 8.5 0 0 1-14.8 5.7L3.5 15.5"/><path d="M3.5 20.5v-5h5"/><path d="M3.5 12a8.5 8.5 0 0 1 14.8-5.7l2.2 2.2"/><path d="M20.5 3.5v5h-5"/>'),
};

// Icon cho bảng so sánh "Cùng một chuyên môn, hai kết quả khác nhau".
const compareIcons: Record<string, string> = {
  slow: painIcons.time,
  talk: painIcons.talk,
  relay: painIcons.relay,
  empty: painSvg('<path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z"/><path d="M10 13.5h4"/>'),
  trash: painSvg('<path d="M4 7h16M9.5 7V4.5h5V7M6 7l1 12.5h10L18 7"/><path d="M10 11v5M14 11v5"/>'),
  fast: painSvg('<path d="M13.5 2.5L5 13.5h6.5l-1 8 8.5-11h-6.5z"/>'),
  teach: painSvg('<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M12 16v4M8.5 20.5h7"/><path d="M7 12.5l3-3 2.5 2.5L17 7.5"/>'),
  asset: painSvg('<path d="M20.5 8L12 3.5 3.5 8v8l8.5 4.5 8.5-4.5z"/><path d="M3.5 8l8.5 4.5L20.5 8M12 12.5v8"/>'),
  grow: painSvg('<path d="M3.5 17l6-6 4 4 7-7"/><path d="M15 8h5.5v5.5"/>'),
  loop: painIcons.loop,
};

// Icon cho mục "Khoá học này dành cho ai".
const fitIcons: Record<string, string> = {
  trainer: painSvg('<circle cx="7" cy="7.5" r="2.5"/><path d="M3 20.5V16a3.5 3.5 0 0 1 3.5-3.5H9l3.5-2.5"/><rect x="12" y="3.5" width="9" height="7" rx="1"/>'),
  manager: painSvg('<circle cx="9" cy="8" r="3.2"/><path d="M3 20v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1"/><path d="M16 4.6a3.2 3.2 0 0 1 0 6.2M18 14.2a5 5 0 0 1 3 4.6V20"/>'),
  library: painSvg('<path d="M4 4.5h4.5v16H4zM8.5 4.5H13v16H8.5z"/><path d="M15 5.4l3.9-1 3.6 14.8-3.9 1z"/>'),
  expert: painSvg('<circle cx="12" cy="9" r="5.5"/><path d="M8.6 13.4L7 21l5-2.6 5 2.6-1.6-7.6"/>'),
  ai: painSvg('<path d="M11 3.5l1.9 5.1L18 10.5l-5.1 1.9L11 17.5l-1.9-5.1L4 10.5l5.1-1.9z"/><path d="M18.5 15v5M16 17.5h5"/>'),
  ready: painSvg('<path d="M5.5 8h13l-1 12.5h-11z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>'),
  noexp: painSvg('<path d="M12 21v-8"/><path d="M12 13c0-4.5-3.5-7-8-7 0 4.5 3.5 7 8 7z"/><path d="M12 11c0-3.5 2.8-6 7-6 0 3.5-2.8 6-7 6z"/>'),
};

const giftTotal = gifts.reduce((sum, g) => sum + g.value, 0);
const nav = [
  { href: homeHref, label: 'Trang chủ' },
  { href: '#ket-qua', label: 'Cảm nhận học viên' },
  { href: '#noi-dung', label: 'Nội dung học' },
  { href: '#giang-vien', label: 'Giảng viên' },
  { href: '#hoc-phi', label: 'Học phí' },
];
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/images/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://donggoitrithuc.mavatraining.com/" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/el/teaching.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <header class="topbar">
      <div class="shell topbar-in">
        <a class="brand" href={homeHref} aria-label="MAVA, trang chủ khoá học">
          <img src="/images/el/logo.png" alt="MAVA" width="480" height="279" />
        </a>
        <nav class="topnav" aria-label="Mục lục trang">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <a class="btn btn-beam" href="#hoc-phi">Đăng ký học</a>
      </div>
    </header>

    <main>
      <!-- Màn hình đầu: khối chữ căn giữa ở trên, ảnh bộ sản phẩm trải rộng bên dưới. -->
      <section class="hero">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="shell hero-in">
          <div class="hero-copy">
            <h1>{course.promise}</h1>
            <p class="hero-lede">{course.lede}</p>
            <div class="hero-cta">
              <a class="btn btn-beam" href="#hoc-phi">Đăng ký học ngay</a>
              <a class="btn btn-ghost" href="#noi-dung">Xem nội dung khoá học</a>
            </div>
            <p class="hero-cadence">{course.cadence}</p>
          </div>

          <div class="stack">
            <picture>
              <source srcset="/images/el/hero-kit.webp" type="image/webp" />
              <img
                class="stack-art"
                src="/images/el/hero-kit.jpg"
                alt="Khoá học E-Learning Kỹ năng Đóng gói Tri thức: bộ 5 tài liệu gồm outline, slide bài giảng, bộ câu hỏi kiểm tra, kế hoạch giảng dạy và sổ tay học viên"
                width="1536"
                height="1024"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
        </div>
      </section>

      <div class="trust">
        <div class="shell trust-in">
          <span><strong>Hơn 6.000</strong> học viên đã đào tạo</span>
          <span><strong>Hơn 6 năm</strong> đào tạo và phát triển con người</span>
        </div>
      </div>

      <section class="band band-paper">
        <div class="shell">
          <div class="rule"></div>
          <h2 class="h-sec">Bạn có đang ở trong tình trạng này không?</h2>

          <ul class="pain-grid">
            {pains.map((p) => (
              <li class="pain-item">
                <span class="pain-ico" aria-hidden="true" set:html={painIcons[p.icon]} />
                <span>{p.text}</span>
              </li>
            ))}
          </ul>

          <div class="pain-close">
            <p class="pain-turn">
              Vấn đề không nằm ở chỗ bạn thiếu kiến thức. Vấn đề là chưa ai chỉ cho bạn quy trình
              đóng gói kiến thức đó lại thành sản phẩm dùng được.
            </p>

            <!-- Minh hoạ: mảnh kiến thức rời rạc đi qua quy trình thành một bộ tài liệu gọn gàng. -->
            <svg class="pain-art" viewBox="0 0 320 150" role="img" aria-label="Kiến thức rời rạc được đóng gói thành bộ tài liệu hoàn chỉnh">
              <g fill="#fff" stroke="#9fb6cf" stroke-width="2" stroke-linejoin="round">
                <rect x="14" y="22" width="46" height="34" rx="6" transform="rotate(-12 37 39)" />
                <rect x="58" y="70" width="46" height="34" rx="6" transform="rotate(9 81 87)" />
                <rect x="10" y="94" width="42" height="32" rx="6" transform="rotate(-6 31 110)" />
              </g>
              <g stroke="#c3d2e3" stroke-width="2" stroke-linecap="round">
                <path d="M26 36h22M28 45h14" transform="rotate(-12 37 39)" />
                <path d="M70 84h22M70 93h14" transform="rotate(9 81 87)" />
                <path d="M20 107h20M20 116h12" transform="rotate(-6 31 110)" />
              </g>
              <circle cx="84" cy="34" r="5" fill="#dceafb" />
              <circle cx="104" cy="120" r="3.5" fill="#dceafb" />
              <path d="M124 76 C 150 52, 176 100, 204 76" fill="none" stroke="#f0a500" stroke-width="3" stroke-dasharray="7 7" stroke-linecap="round" />
              <path d="M196 67l10 9-12 5" fill="none" stroke="#f0a500" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              <rect x="232" y="40" width="62" height="80" rx="8" fill="#dceafb" />
              <rect x="224" y="32" width="62" height="80" rx="8" fill="#fff" stroke="#0b1e35" stroke-width="2.5" />
              <rect x="236" y="46" width="38" height="8" rx="4" fill="#ffce1f" />
              <path d="M236 66h38M236 78h38M236 90h24" stroke="#0b1e35" stroke-width="2.5" stroke-linecap="round" opacity=".55" />
              <circle cx="290" cy="112" r="15" fill="#ffce1f" stroke="#0b1e35" stroke-width="2.5" />
              <path d="M283 112l5 5 9-10" fill="none" stroke="#0b1e35" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
        </div>
      </section>

      <!-- Cam nhan hoc vien: dung anh dai dien lam mat na, bam moi nhung iframe.
           Nhung thang 6 iframe YouTube se lam trang nang len rat nhieu. -->
      <section class="band" id="ket-qua">
        <div class="shell">
          <div class="rule"></div>
          <h2 class="h-sec">Và đây là kết quả</h2>
          <p class="sec-lede">
            Học viên các chương trình của MAVA nói về Kỹ năng Đóng gói Tri thức. Bấm vào từng video
            để nghe trực tiếp.
          </p>

          <div class="vids">
            {testimonialVideos.map((v) => (
              <button class="vid" type="button" data-id={v.id} aria-label={`Phát video cảm nhận của ${v.name}`}>
                <span class="vid-frame">
                  <img
                    src={`https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`}
                    alt=""
                    width="1280"
                    height="720"
                    loading="lazy"
                  />
                  <span class="vid-play" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
                  </span>
                </span>
                <span class="vid-name">{v.name}</span>
                <span class="vid-role">{v.role}</span>
              </button>
            ))}
          </div>
        </div>
      </section>

      <section class="band band-paper">
        <div class="shell">
          <div class="rule"></div>
          <h2 class="h-sec">Cùng một chuyên môn, hai kết quả khác nhau</h2>
          <p class="vs-lede">
            <mark>Giỏi, nhưng khi cần chứng minh thì không có gì để mở ra cho người khác xem</mark>
          </p>

          <!-- Hiện trạng bên trái, kết quả sau khoá học bên phải, đọc theo đúng chiều trước rồi sau. -->
          <div class="vs">
            <div class="vs-col vs-no">
              <div class="vs-top">
                <!-- Minh hoạ: cái đầu với mớ ý nghĩ rối, kiến thức chưa được sắp xếp. -->
                <svg class="vs-art" viewBox="0 0 64 64" aria-hidden="true">
                  <circle cx="32" cy="32" r="30" fill="#eef3f9" />
                  <path d="M25 52v-6.5c-6-2.4-9.5-8-9.5-14.5a16.5 16.5 0 0 1 33 0c0 2.4 1.3 4.4 3 6.4l-3.3 1.6v4.5a3.5 3.5 0 0 1-3.5 3.5H40V52" fill="#fff" stroke="#9fb0c4" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M24 29c3-6 11-3 8 2s-9 1-5-4 12-2 10 4-7 5-9 1" fill="none" stroke="#9fb0c4" stroke-width="2" stroke-linecap="round" />
                </svg>
                <p class="vs-head">Khi kiến thức vẫn nằm trong đầu</p>
              </div>
              <ul>
                {comparison.map((c) => (
                  <li>
                    <span class="vs-ico" aria-hidden="true" set:html={compareIcons[c.unpackedIcon]} />
                    <span>{c.unpacked}</span>
                  </li>
                ))}
              </ul>
            </div>
            <span class="vs-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <div class="vs-col vs-yes">
              <div class="vs-top">
                <!-- Minh hoạ: bộ tài liệu đã đóng gói gọn gàng, có dấu tích hoàn thành. -->
                <svg class="vs-art" viewBox="0 0 64 64" aria-hidden="true">
                  <circle cx="32" cy="32" r="30" fill="#13314f" />
                  <rect x="22" y="14" width="26" height="32" rx="3.5" fill="#1c4571" />
                  <rect x="17" y="18" width="26" height="32" rx="3.5" fill="#fff" />
                  <rect x="22" y="24" width="14" height="4" rx="2" fill="#ffce1f" />
                  <path d="M22 33h16M22 39h11" stroke="#0b1e35" stroke-width="2.2" stroke-linecap="round" opacity=".5" />
                  <circle cx="44" cy="46" r="8" fill="#ffce1f" />
                  <path d="M40.5 46l2.5 2.5 4.5-5" fill="none" stroke="#0b1e35" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <p class="vs-head">Khi bạn biết đóng gói</p>
              </div>
              <ul>
                {comparison.map((c) => (
                  <li>
                    <span class="vs-ico" aria-hidden="true" set:html={compareIcons[c.packedIcon]} />
                    <span>{c.packed}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="band band-ink">
        <div class="shell">
          <div class="rule"></div>
          <h2 class="h-sec">Quy trình này đã chạy thật trong doanh nghiệp</h2>
          <p class="sec-lede">
            Hình ảnh từ các lớp Đóng gói Tri thức và Nhân bản Nhân tài do MAVA tổ chức tại doanh
            nghiệp. Bản E-Learning là chính quy trình đó, chia nhỏ để bạn tự học.
          </p>

          <div class="gal">
            {gallery.map((g) => (
              <figure>
                <img src={g.src} alt={g.alt} loading="lazy" />
                <figcaption>{g.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="band band-paper">
        <div class="shell">
          <div class="rule"></div>
          <h2 class="h-sec">Khoá học này dành cho ai</h2>

          <div class="fit">
            <div class="fit-col fit-yes">
              <div class="fit-top">
                <!-- Minh hoạ: một người với dấu tích vàng, đúng đối tượng. -->
                <svg class="fit-art" viewBox="0 0 56 56" aria-hidden="true">
                  <circle cx="28" cy="28" r="27" fill="#fff1c2" />
                  <circle cx="26" cy="22" r="8" fill="#fff" stroke="#0b1e35" stroke-width="2.2" />
                  <path d="M12 44c1.5-8 7-12 14-12s12.5 4 14 12" fill="#fff" stroke="#0b1e35" stroke-width="2.2" stroke-linecap="round" />
                  <circle cx="41" cy="38" r="8" fill="#ffce1f" stroke="#0b1e35" stroke-width="2" />
                  <path d="M37.5 38l2.5 2.5 4.5-5" fill="none" stroke="#0b1e35" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <h3>Phù hợp với bạn nếu</h3>
              </div>
              <ul>
                {audienceFit.map((a) => (
                  <li>
                    <span class="fit-ico" aria-hidden="true" set:html={fitIcons[a.icon]} />
                    <span>{a.text}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="fit-col fit-no">
              <div class="fit-top">
                <!-- Minh hoạ: một người với dấu chéo xám, chưa phải lúc. -->
                <svg class="fit-art" viewBox="0 0 56 56" aria-hidden="true">
                  <circle cx="28" cy="28" r="27" fill="#eef3f9" />
                  <circle cx="26" cy="22" r="8" fill="#fff" stroke="#8a97a8" stroke-width="2.2" />
                  <path d="M12 44c1.5-8 7-12 14-12s12.5 4 14 12" fill="#fff" stroke="#8a97a8" stroke-width="2.2" stroke-linecap="round" />
                  <circle cx="41" cy="38" r="8" fill="#fff" stroke="#8a97a8" stroke-width="2" />
                  <path d="M38 35l6 6M44 35l-6 6" stroke="#8a97a8" stroke-width="2.2" stroke-linecap="round" />
                </svg>
                <h3>Chưa phù hợp nếu</h3>
              </div>
              <ul>
                {audienceMisfit.map((a) => (
                  <li>
                    <span class="fit-ico" aria-hidden="true" set:html={fitIcons[a.icon]} />
                    <span>{a.text}</span>
                  </li>
                ))}
              </ul>

              <!-- Minh hoạ lấp khoảng trống cuối cột: biển chỉ đường, một hướng tự tay làm (vàng), một hướng lấy sẵn (xám). -->
              <svg class="fit-sign" viewBox="0 0 240 150" aria-hidden="true">
                <ellipse cx="120" cy="138" rx="70" ry="7" fill="#eef3f9" />
                <rect x="115" y="20" width="10" height="118" rx="3" fill="#c3d0de" />
                <path d="M128 30h72l16 15-16 15h-72z" fill="#ffce1f" stroke="#0b1e35" stroke-width="2.2" stroke-linejoin="round" />
                <path d="M150 45l6 6 12-12" fill="none" stroke="#0b1e35" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M112 72H44L28 87l16 15h68z" fill="#fff" stroke="#9fb0c4" stroke-width="2.2" stroke-linejoin="round" />
                <path d="M64 81l12 12M76 81L64 93" stroke="#9fb0c4" stroke-width="3" stroke-linecap="round" />
                <circle cx="120" cy="16" r="6" fill="#c3d0de" />
              </svg>
            </div>
          </div>
        </div>
      </section>

      <section class="band" id="noi-dung">
        <div class="shell">
          <div class="rule"></div>
          <h2 class="h-sec">Toàn bộ nội dung bạn sẽ học</h2>

          <div class="parts">
            {curriculum.map((p, i) => (
              <>
                <article class="part">
                  <div class:list={['part-tile', p.image && 'part-tile-art']}>
                    {p.image ? (
                      <picture>
                        <source srcset={`${p.image}.webp`} type="image/webp" />
                        <img
                          src={`${p.image}.jpg`}
                          alt=""
                          width="600"
                          height="800"
                          loading="lazy"
                          decoding="async"
                        />
                      </picture>
                    ) : (
                      <>
                        <span class="part-tile-icon" aria-hidden="true" set:html={partIcons[p.icon]} />
                        <span class="part-tile-name">{p.tag}</span>
                      </>
                    )}
                  </div>

                  <div class="part-body">
                    <p class="part-kicker">Phần {i + 1}</p>
                    <h3>{p.title}</h3>
                    <ul class="part-items">
                      {p.items.map((it) => <li>{it}</li>)}
                    </ul>
                    <p class="part-out"><b>Sau phần này bạn có thể:</b> {p.outcome}</p>
                  </div>
                </article>

                {i < curriculum.length - 1 && (
                  <div class="part-link" aria-hidden="true">
                    <svg viewBox="0 0 150 100" width="150" height="100" fill="none">
                      <path
                        d="M24 6C24 32 104 26 104 52c0 20 14 28 26 36"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-dasharray="8 9"
                      />
                      <path
                        d="M123.3 74.6 130 88l-14.9-.9"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>
                )}
              </>
            ))}
          </div>
        </div>
      </section>

      <!-- Toàn bộ mục này là một tấm ảnh do khách hàng thiết kế sẵn,
           đã kèm tiêu đề nên không dựng lại tiêu đề bằng chữ nữa. -->
      <section class="band band-paper">
        <div class="shell">
          <picture>
            <source srcset="/images/el/vi-sao-elearning.webp" type="image/webp" />
            <img
              class="banner"
              src="/images/el/vi-sao-elearning.jpg"
              alt="Vì sao nên học bản E-Learning: học mọi lúc mọi nơi trên máy tính hoặc điện thoại, truy cập trọn đời xem lại không giới hạn, học theo từng module ngắn 10 đến 15 phút, cập nhật miễn phí trọn đời."
              width="1600"
              height="901"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
      </section>

      <section class="band band-ink" id="giang-vien">
        <div class="shell coach">
          <div class="coach-photo">
            <img
              src="/images/v2/hero-portrait.jpg"
              alt={`Trainer ${trainer.name}, ${trainer.role}`}
              loading="lazy"
            />
          </div>
          <div>
            <div class="rule"></div>
            <h2>{trainer.name}</h2>
            <p class="coach-role">{trainer.role} | Trainer | {trainer.credential}</p>
            <div class="coach-story">
              {trainer.story.map((s) => <p>{s}</p>)}
            </div>
            <div class="coach-clients">
              <p class="coach-clients-h">Đã đào tạo cho đội ngũ tại</p>
              <div class="chips">
                {trainer.clients.map((c) => <span class="chip">{c}</span>)}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="band band-paper">
        <div class="shell">
          <div class="rule"></div>
          <h2 class="h-sec h-icon">
            <svg class="h-icon-art" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2.2" y="7.6" width="19.6" height="4.6" rx="1.3" />
              <path d="M4.1 12.2h15.8v7.9a1.5 1.5 0 0 1-1.5 1.5H5.6a1.5 1.5 0 0 1-1.5-1.5z" />
              <path d="M12 7.6v14" />
              <path d="M12 7.6S10.7 2.6 8.2 2.6a2.5 2.5 0 0 0 0 5z" />
              <path d="M12 7.6s1.3-5 3.8-5a2.5 2.5 0 0 1 0 5z" />
            </svg>
            <span>Bốn phần quà đi kèm khi đăng ký</span>
          </h2>

          <!-- Mỗi phần quà là một tấm ảnh đã kèm sẵn tên, mô tả và trị giá,
               nên không dựng lại các phần đó bằng chữ. Bảng kê ở mục học phí
               vẫn giữ tên và giá dạng chữ để máy đọc và Google hiểu được. -->
          <div class="gifts">
            {gifts.map((g) => (
              <picture class="gift">
                <source srcset={`${g.image}.webp`} type="image/webp" />
                <img
                  src={`${g.image}.jpg`}
                  alt={`${g.name}, trị giá ${vnd(g.value)}. ${g.body}`}
                  width="620"
                  height="980"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            ))}
          </div>
        </div>
      </section>

      <section class="band band-ink" id="hoc-phi">
        <div class="shell">
          <div class="rule"></div>
          <h2 class="h-sec h-sec-wide">Đăng ký khoá <span class="nw">E-Learning</span> Kỹ năng Đóng gói Tri thức</h2>

          <div class="offer" style="margin-top: 40px">
            <div>
              <div class="manifest">
                <h3>Bạn nhận được những gì</h3>
                <div class="mline">
                  <span>Khoá E-Learning Kỹ năng Đóng gói Tri thức</span>
                  <span class="mline-val">{vnd(course.originalPrice - giftTotal)}</span>
                </div>
                {gifts.map((g) => (
                  <div class="mline">
                    <span>{g.name}</span>
                    <span class="mline-val">{vnd(g.value)}</span>
                  </div>
                ))}
                <div class="mtotal">
                  <span>Tổng giá trị</span>
                  <s>{vnd(course.originalPrice)}</s>
                </div>
              </div>
            </div>

            <!-- Giá ưu đãi và đồng hồ đứng ngay trên form, để người đọc thấy mức giá
                 và thời hạn đúng lúc chuẩn bị điền thông tin. -->
            <div class="offer-side">
              <div class="price-now">
                <p class="price-now-lab">Học phí ưu đãi đợt này</p>
                <p class="price-now-num">{vnd(course.price)}</p>
                <p class="price-now-sub">
                  Tiết kiệm {course.discountPercent}%, dành cho {course.seatLimit} học viên đăng ký
                  sớm nhất. Học phí tăng khi ưu đãi kết thúc.
                </p>
              </div>

              <div class="clock">
                <span>Ưu đãi còn</span>
                <span class="clock-num" id="cd-m" aria-label="số phút còn lại">30</span>
                <span>phút</span>
                <span class="clock-num" id="cd-s" aria-label="số giây còn lại">00</span>
                <span>giây</span>
              </div>

            <div class="form-card">
              <div id="form-live">
                <h3>Để lại thông tin đăng ký</h3>

                <form id="reg-form" novalidate>
                  <label class="field">
                    Họ và tên
                    <input type="text" name="name" autocomplete="name" placeholder="Nguyễn Văn A" required />
                  </label>
                  <label class="field">
                    Số điện thoại
                    <input
                      type="tel"
                      name="phone"
                      autocomplete="tel"
                      inputmode="numeric"
                      placeholder="09xxxxxxxx"
                      pattern="[0-9+ .]{9,15}"
                      required
                    />
                  </label>
                  <label class="field">
                    Email
                    <input type="email" name="email" autocomplete="email" placeholder="ban@congty.com" required />
                  </label>

                  <button type="submit" class="btn btn-beam btn-wide">Đăng ký học ngay</button>
                  <!-- Ô này để trống, chỉ hiện chữ khi script báo lỗi nhập liệu
                       hoặc báo form chưa nối. Xoá hẳn thẻ thì script mất chỗ ghi. -->
                  <p class="form-note" id="form-msg"></p>
                </form>
              </div>

              <div class="form-done" id="form-done" hidden>
                <h3>Đã nhận đăng ký của bạn</h3>
                <p>
                  Tư vấn viên MAVA sẽ gọi lại theo số bạn để lại để xác nhận và mở tài khoản học.
                  Cần gấp thì gọi thẳng {contact.hotline}.
                </p>
              </div>
            </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="shell">
        <div class="foot-in">
          <div>
            <img src="/images/el/logo.png" alt="MAVA" width="480" height="279" />
            <p class="foot-co">{contact.company}</p>
            <p>{contact.address}</p>
          </div>
          <div class="foot-right">
            <p>Hotline <a href={`tel:${contact.hotlineTel}`}>{contact.hotline}</a></p>
            <p>Email <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
          </div>
        </div>
        <p class="foot-legal">© {new Date().getFullYear()} MAVA. Khoá học E-Learning Kỹ năng Đóng gói Tri thức.</p>
      </div>
    </footer>

    <!-- Hiện trong lúc gửi đăng ký và tạo mã QR, để học viên không tưởng trang bị treo mà bấm lại hoặc thoát. -->
    <div class="wait" id="reg-wait" role="status" aria-live="polite" hidden>
      <div class="wait-card">
        <span class="wait-spin" aria-hidden="true"></span>
        <p class="wait-title">Vui lòng chờ trong 1-2 phút</p>
        <p class="wait-text">Chúng tôi đang tạo QR Code thanh toán!</p>
      </div>
    </div>

    <div class="dock">
      <div class="dock-price">
        <s>{vnd(course.originalPrice)}</s>
        <b>{vnd(course.price)}</b>
      </div>
      <a class="btn btn-beam" href="#hoc-phi">Đăng ký học</a>
    </div>

    <button type="button" class="to-top" id="to-top" aria-label="Lên đầu trang" title="Lên đầu trang">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <script>
      // Nút lên đầu trang chỉ hiện khi đã kéo xuống quá một màn hình.
      (function toTop() {
        const btn = document.getElementById('to-top');
        if (!btn) return;
        const sync = () => btn.classList.toggle('is-on', window.scrollY > window.innerHeight * 0.8);
        window.addEventListener('scroll', sync, { passive: true });
        sync();
        btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      })();
    </script>

    <script define:vars={{ endpoint: registerForm.endpoint, goCheckout: checkoutReady(), minutes: course.countdownMinutes, hotline: contact.hotline }}>
      // Đồng hồ ưu đãi. Mốc kết thúc lưu trong localStorage để không nhảy lại
      // mỗi lần người xem tải lại trang trong cùng một phiên.
      (function countdown() {
        const mEl = document.getElementById('cd-m');
        const sEl = document.getElementById('cd-s');
        if (!mEl || !sEl) return;

        const KEY = 'mava-el-offer-until';
        let until = Number(localStorage.getItem(KEY) || 0);
        if (!until || until < Date.now()) {
          until = Date.now() + minutes * 60 * 1000;
          localStorage.setItem(KEY, String(until));
        }

        function tick() {
          const left = Math.max(0, until - Date.now());
          const total = Math.floor(left / 1000);
          mEl.textContent = String(Math.floor(total / 60)).padStart(2, '0');
          sEl.textContent = String(total % 60).padStart(2, '0');
          if (left > 0) setTimeout(tick, 1000);
        }
        tick();
      })();

      // Bam vao anh dai dien thi moi nap iframe YouTube, va phat luon.
      // Nap san ca 6 iframe se keo tut toc do tai trang.
      (function videos() {
        document.querySelectorAll('.vid').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.dataset.id;
            const frame = btn.querySelector('.vid-frame');
            if (!id || !frame || frame.querySelector('iframe')) return;

            const iframe = document.createElement('iframe');
            iframe.src =
              'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
            iframe.title = btn.getAttribute('aria-label') || '';
            iframe.allow =
              'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
            iframe.allowFullscreen = true;
            frame.replaceChildren(iframe);
          });
        });
      })();

      // Gửi đăng ký về Google Sheet qua Apps Script. Chưa có endpoint thì nhắc gọi hotline
      // để trang không bao giờ nuốt mất một lead.
      (function register() {
        const form = document.getElementById('reg-form');
        const msg = document.getElementById('form-msg');
        const live = document.getElementById('form-live');
        const done = document.getElementById('form-done');
        if (!form) return;

        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          if (!form.checkValidity()) {
            msg.textContent = 'Vui lòng điền đủ họ tên, số điện thoại và email hợp lệ.';
            form.reportValidity();
            return;
          }

          if (!endpoint) {
            msg.textContent =
              'Form đăng ký chưa được kết nối. Vui lòng gọi ' + hotline + ' để đăng ký trực tiếp.';
            return;
          }

          const btn = form.querySelector('button[type="submit"]');
          btn.disabled = true;
          btn.textContent = 'Đang gửi...';
          const wait = document.getElementById('reg-wait');
          if (wait) wait.hidden = false;

          // form.name lấy ra thuộc tính của thẻ form, không phải ô nhập liệu.
          const el = form.elements;
          // Gửi dạng x-www-form-urlencoded để là "simple request", trình duyệt không cần
          // hỏi trước (preflight) mà Apps Script không trả lời được.
          const body = new URLSearchParams({
            name: el.name.value.trim(),
            phone: el.phone.value.trim(),
            email: el.email.value.trim(),
            page: location.href,
          });

          try {
            // Apps Script chuyển hướng sang googleusercontent nên phản hồi là opaque,
            // không đọc được. Chỉ lỗi mạng mới rơi xuống catch.
            await fetch(endpoint, { method: 'POST', mode: 'no-cors', body });

            // Trang thanh toán đọc lại họ tên và số điện thoại để điền nội dung chuyển khoản.
            // Lưu ở sessionStorage chứ không gắn lên URL để thông tin cá nhân không lộ khi chia sẻ link.
            if (goCheckout) {
              try {
                sessionStorage.setItem(
                  'mava-reg',
                  JSON.stringify({ name: el.name.value.trim(), phone: el.phone.value.trim() })
                );
              } catch (e) {}
              location.href = '/thanh-toan/';
              return;
            }

            live.hidden = true;
            done.hidden = false;
            done.scrollIntoView({ block: 'center', behavior: 'smooth' });
          } catch (err) {
            const waitEl = document.getElementById('reg-wait');
            if (waitEl) waitEl.hidden = true;
            btn.disabled = false;
            btn.textContent = 'Đăng ký học ngay';
            msg.textContent =
              'Chưa gửi được, có thể do đường truyền. Vui lòng thử lại hoặc gọi ' + hotline + '.';
          }
        });
      })();
    </script>
    <Tracker />
  </body>
</html>
