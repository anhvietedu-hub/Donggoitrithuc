        <!-- Pricing -->
        <section class="section-pad pricing-section" id="hoc-phi">
          <div class="container-mava">
            <div class="section-intro reveal">
              <div><span class="eyebrow">10 / Chọn cách bắt đầu</span><h2>Một người làm.<br /><em>Cả đội cùng làm.</em></h2></div>
              <p>Bạn có thể bắt đầu từ chính tri thức của mình hoặc mở ra một dự án tri thức chung cho doanh nghiệp.</p>
            </div>
            <div class="pricing-grid reveal delay-1">
              <article class="price-card featured">
                <h3>Cá nhân thực chiến</h3>
                <p>Dành cho chuyên gia, giảng viên, L&D muốn hoàn thiện một sản phẩm tri thức đầu tiên.</p>
                <div class="price"><strong>1.490.000</strong><span>VNĐ</span></div>
                <ul>{individual.map((item) => <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> {item}</li>)}</ul>
                <button class="button-primary button-yellow" data-scroll-to="dang-ky" type="button">
                  Đăng ký khóa học
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </button>
              </article>
              <article class="price-card">
                <h3>Doanh nghiệp / đội ngũ</h3>
                <p>Dành cho HR, L&D và quản lý muốn chuẩn hóa tri thức từ những người giỏi nhất.</p>
                <div class="price"><strong>Trao đổi</strong><span>theo quy mô</span></div>
                <ul>{business.map((item) => <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> {item}</li>)}</ul>
                <button class="button-ghost" data-scroll-to="dang-ky" type="button">
                  Nhận tư vấn cho đội ngũ
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </button>
              </article>
            </div>
            <p class="price-note">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:5px"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
              Thông tin đăng ký được bảo mật. Không spam, không gọi làm phiền.
            </p>
          </div>
        </section>

        <!-- FAQ -->
        <section class="section-pad" id="faq">
          <div class="container-mava faq-grid">
            <div class="reveal">
              <span class="eyebrow">11 / Câu hỏi thường gặp</span>
              <h2>Cứ hỏi<br /><em>thẳng.</em></h2>
              <p>Nếu bạn chưa thấy câu trả lời, để lại thông tin ở phần cuối. Đội ngũ MAVA sẽ trao đổi đúng điều bạn cần, không gửi một kịch bản bán hàng chung chung.</p>
            </div>
            <div class="faq-list reveal delay-1" id="faq-list">
              {faqs.map(([question, answer], index) => (
                <div class="faq-item" data-faq-index={index}>
                  <button class="faq-question" type="button" aria-expanded="false">
                    <span>{question}</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                  </button>
                  <div class="faq-answer">{answer}</div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- CTA -->
        <section class="section-pad cta-section" id="dang-ky">
          <div class="container-mava cta-grid">
            <div class="cta-copy reveal">
              <span class="eyebrow">12 / Bước tiếp theo là của bạn</span>
              <h2>Đừng để tri thức của bạn <em>thất lạc.</em></h2>
              <p>Trong 24 giờ tới, hãy dành một khoảng nhỏ để nhìn lại điều bạn biết rõ nhất. MAVA sẽ giúp bạn biến nó thành một hệ thống có thể sống tiếp.</p>
              <div class="countdown" id="countdown">
                <div class="countdown-unit"><strong id="countdown-hours">24</strong><span>giờ</span></div>
                <div class="countdown-unit"><strong id="countdown-minutes">00</strong><span>phút</span></div>
                <div class="countdown-unit"><strong id="countdown-seconds">00</strong><span>giây</span></div>
              </div>
              <div style="display:flex;gap:8px;align-items:center;margin-top:27px;color:rgba(246,243,235,.58);font-size:11px">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6h4"/></svg>
                Ưu đãi tư vấn đầu vào hiển thị trong 24 giờ
              </div>
            </div>

            <div class="form-card reveal delay-1">
              <div id="registration-form-wrap">
                <h3>Để lại một lời chào.</h3>
                <p>Nhận lộ trình phù hợp với vai trò của bạn và lịch khai giảng gần nhất từ MAVA.</p>
                <form class="form-fields" id="registration-form">
                  <div class="form-field"><label for="name">Họ và tên</label><input id="name" name="name" required placeholder="Nguyễn Văn A" /></div>
                  <div class="form-field"><label for="phone">Số điện thoại</label><input id="phone" name="phone" required type="tel" placeholder="09xx xxx xxx" /></div>
                  <div class="form-field"><label for="email">Email</label><input id="email" name="email" required type="email" placeholder="ten@congty.vn" /></div>
                  <button class="button-primary" type="submit">
                    Gửi thông tin
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </button>
                </form>
                <div class="form-trust">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="16" r="1"/><rect x="3" y="10" width="18" height="12" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/></svg>
                  Thông tin của bạn chỉ được dùng để tư vấn khóa học. MAVA tôn trọng quyền riêng tư của bạn.
                </div>
              </div>
              <div class="success-state" id="registration-success" style="display:none">
                <div class="success-icon"><svg width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="#1d2c3d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m16 9-5.5 5.5L8 12"/></svg></div>
                <h3>Đã nhận lời chào.</h3>
                <p id="registration-success-text">Cảm ơn bạn. MAVA sẽ liên hệ với bạn trong giờ làm việc gần nhất để cùng chọn bước bắt đầu phù hợp.</p>
                <button class="button-ghost" id="registration-reset" type="button">Gửi thông tin khác</button>
              </div>
            </div>
          </div>
        </section>
      </main>

      <footer class="footer">
        <div class="container-mava footer-inner">
          <img src="/images/v2/logo.png" alt="MAVA" />
          <span>MAVA · Biến tri thức thành năng lực có thể nhân rộng.</span>
          <div class="footer-links"><a href="#faq">FAQ</a><a href="#dang-ky">Đăng ký</a><a href="#dau-trang">Về đầu trang</a></div>
        </div>
      </footer>
    </div>

    <script>
      function scrollToId(id: string) {
        document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      document.querySelectorAll('[data-scroll-to]').forEach((el) => {
        el.addEventListener('click', () => {
          const id = el.getAttribute('data-scroll-to');
          if (id) scrollToId(id);
        });
      });

      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const navLinks = document.getElementById('nav-links');
      mobileMenuBtn?.addEventListener('click', () => {
        navLinks?.classList.toggle('open');
        mobileMenuBtn.classList.toggle('open');
      });
      navLinks?.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => {
          navLinks.classList.remove('open');
          mobileMenuBtn?.classList.remove('open');
        });
      });

      const observer = new IntersectionObserver(
        (entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('is-visible')),
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));

      let seconds = 24 * 60 * 60;
      const hoursEl = document.getElementById('countdown-hours');
      const minutesEl = document.getElementById('countdown-minutes');
      const secondsEl = document.getElementById('countdown-seconds');
      function renderCountdown() {
        const h = String(Math.floor(seconds / 3600)).padStart(2, '0');
        const m = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
        const s = String(seconds % 60).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = h;
        if (minutesEl) minutesEl.textContent = m;
        if (secondsEl) secondsEl.textContent = s;
      }
      renderCountdown();
      setInterval(() => {
        seconds = seconds > 0 ? seconds - 1 : 24 * 60 * 60;
        renderCountdown();
      }, 1000);

      const audienceTabs = document.getElementById('audience-tabs');
      audienceTabs?.querySelectorAll('.audience-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          const id = tab.getAttribute('data-audience');
          audienceTabs.querySelectorAll('.audience-tab').forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');
          document.querySelectorAll('.audience-view').forEach((panel) => {
            panel.classList.toggle('active', panel.getAttribute('data-audience-panel') === id);
          });
        });
      });

      document.getElementById('faq-list')?.querySelectorAll('.faq-item').forEach((item) => {
        const question = item.querySelector('.faq-question');
        question?.addEventListener('click', () => {
          const isOpen = item.classList.contains('open');
          document.querySelectorAll('#faq-list .faq-item').forEach((el) => {
            el.classList.remove('open');
            el.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
          });
          if (!isOpen) {
            item.classList.add('open');
            question.setAttribute('aria-expanded', 'true');
          }
        });
      });

      const form = document.getElementById('registration-form') as HTMLFormElement | null;
      const formWrap = document.getElementById('registration-form-wrap');
      const successState = document.getElementById('registration-success');
      const successText = document.getElementById('registration-success-text');
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        const nameInput = form.querySelector<HTMLInputElement>('#name');
        const name = nameInput?.value.trim() ?? '';
        if (formWrap) formWrap.style.display = 'none';
        if (successState) successState.style.display = 'block';
        if (successText) successText.textContent = `Cảm ơn ${name}. MAVA sẽ liên hệ với bạn trong giờ làm việc gần nhất để cùng chọn bước bắt đầu phù hợp.`;
      });
      document.getElementById('registration-reset')?.addEventListener('click', () => {
        form?.reset();
        if (successState) successState.style.display = 'none';
        if (formWrap) formWrap.style.display = 'block';
      });
    </script>
  </body>
</html>
