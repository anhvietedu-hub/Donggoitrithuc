        <!-- Proof -->
        <section class="section-pad proof-section">
          <div class="container-mava">
            <div class="proof-layout">
              <div class="reveal">
                <img src="/images/v2/team.jpg" alt="Một buổi đào tạo của MAVA" class="proof-photo" width="2000" height="1500" />
                <div class="gallery">
                  <img src="/images/v2/team-two.jpg" alt="Đội ngũ học viên MAVA" width="2000" height="1500" />
