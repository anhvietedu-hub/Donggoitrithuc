        <!-- Compare -->
        <section class="section-pad compare">
          <div class="container-mava">
            <div class="section-intro reveal">
              <div><span class="eyebrow">07 / Một thay đổi nhìn thấy được</span><h2>Trước và<br /><em>sau khi đóng gói.</em></h2></div>
